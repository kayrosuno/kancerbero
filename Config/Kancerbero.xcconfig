#include "Base.xcconfig"

PRODUCT_NAME = Kancerbero
PRODUCT_BUNDLE_IDENTIFIER = uno.kayros.kancerbero
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Resources/App/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ENABLE_APP_SANDBOX = NO
// Release only: Debug signs automatically with Apple Development and does not
// use a provisioning profile specifier.
PROVISIONING_PROFILE_SPECIFIER[config=Release] = $(KANCERBERO_APP_PROFILE)
// The app embeds already-signed products (daemon and system extension) and
// re-signs them with CodeSignOnCopy. COPY_PHASE_STRIP makes builtin-copy try to
// strip them, which it refuses with "not stripping binary because it is signed".
// Each target strips its own product via STRIP_INSTALLED_PRODUCT instead.
COPY_PHASE_STRIP = NO
OTHER_LDFLAGS = $(inherited) -framework CoreFoundation -framework IOKit -framework DiskArbitration -framework ServiceManagement -framework NetworkExtension
SWIFT_INCLUDE_PATHS = $(BUILT_PRODUCTS_DIR) $(inherited)
