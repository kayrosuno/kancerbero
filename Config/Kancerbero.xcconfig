#include "Base.xcconfig"

PRODUCT_NAME = Kancerbero
PRODUCT_BUNDLE_IDENTIFIER = uno.kayros.kancerbero
MARKETING_VERSION = $(KANCERBERO_MARKETING_VERSION)
CURRENT_PROJECT_VERSION = $(KANCERBERO_BUILD_VERSION)
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Resources/App/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ENABLE_APP_SANDBOX = NO
// Release only: Debug signs automatically with Apple Development and does not
// use a provisioning profile specifier.
PROVISIONING_PROFILE_SPECIFIER[config=Release] = $(KANCERBERO_APP_PROFILE)
// The app embeds already-signed products (daemon and system extension) and
// re-signs them with CodeSignOnCopy. COPY_PHASE_STRIP makes builtin-copy try to
// strip them, which it refuses with "not stripping binary because it is signed".
// Each target strips its own product via STRIP_INSTALLED_PRODUCT instead.
COPY_PHASE_STRIP = NO
// The Re-sign Sparkle helpers phase writes inside the built app to re-sign
// Sparkle's nested executables with the app's Developer ID identity and a
// secure timestamp; the script sandbox blocks that write.
ENABLE_USER_SCRIPT_SANDBOXING = NO
OTHER_LDFLAGS = $(inherited) -framework CoreFoundation -framework Security -framework IOKit -framework DiskArbitration -framework ServiceManagement -framework NetworkExtension
// Sparkle.framework is embedded in Contents/Frameworks by the SPM product.
// Keep both paths so the debug dylib and the release executable resolve it.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @loader_path/../Frameworks
SWIFT_INCLUDE_PATHS = $(BUILT_PRODUCTS_DIR) $(inherited)
