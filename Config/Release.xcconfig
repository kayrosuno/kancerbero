#include "Base.xcconfig"

SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_NS_ASSERTIONS = NO
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
// DEVELOPMENT_TEAM is not set here: the project configuration provides it so
// every target, including the daemon, can be signed with Developer ID. The
// daemon must still have no App ID, entitlements or provisioning profile;
// build-release.sh verifies the signed binary.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_HARDENED_RUNTIME = YES
OTHER_CODE_SIGN_FLAGS = --options runtime --timestamp
